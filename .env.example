# Copy to `.env` (gitignored) and fill in your own values.
# Used only by the opt-in integration tests against live myclub.fi.
# Nothing here is committed — `.env` is ignored by git.

MAIKLUBI_INTEGRATION=1
MAIKLUBI_EMAIL=you@example.fi
MAIKLUBI_PASSWORD=your-password

# Test coordinates — a member/event in YOUR account to read & toggle RSVP on.
# The write-cycle test always restores the original indication.
MAIKLUBI_TEST_CLUB_URL=https://yourclub.myclub.fi
MAIKLUBI_TEST_MEMBER_ID=000000
MAIKLUBI_TEST_EVENT_ID=0000000

# Optional: comma-separated member IDs expected on the home page (asserts login+parsing).
# Leave unset to skip that assertion.
MAIKLUBI_TEST_EXPECTED_IDS=
